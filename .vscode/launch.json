      "args": ["--dart-define=API_BASE_URL=http://localhost:8000"]
    },
    {
      "name": "Physical device (LAN IP — edit me)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.1.100:8000"]
    }
  ]
