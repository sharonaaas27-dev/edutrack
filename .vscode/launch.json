{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mock (offline, no backend)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=USE_MOCK_DATA=true"]
    },
    {
      "name": "Emulator + local backend (10.0.2.2)",
