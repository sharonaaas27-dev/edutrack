# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://edutrack:edutrack@localhost:5432/edutrack
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
APP_NAME=EduTrack API
# Stage 6: JWT authentication. Generate a real secret per environment, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`. The default
# below is for local development only.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
